<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Machine Tower Defense - Summon Demo</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
/* ========== CARD STYLE ========== */
.unit-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
  margin-top: 20px;
}

.unit-card {
  background: #0a0a0a;
  color: #fff;
  border: 2px solid #00ffff;
  border-radius: 14px;
  padding: 15px;
  text-align: center;
  box-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
  transition: transform 0.2s, box-shadow 0.2s;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.unit-card:hover {
  transform: scale(1.05);
  box-shadow: 0 0 25px rgba(0, 255, 255, 0.7);
}

.unit-card h3 {
  font-size: 1.2rem;
  font-weight: bold;
  margin-bottom: 10px;
  color: #00ffff;
  text-shadow: 0 0 8px #00ffff;
}

/* Rarity colors */
.normal { border-color: #00ffff; }
.special { border-color: gold; box-shadow: 0 0 10px gold; }
.large { border-color: lime; box-shadow: 0 0 10px lime; }
.titan { border-color: red; box-shadow: 0 0 15px red; }
.upgraded { border-color: #007bff; box-shadow: 0 0 15px #007bff; }
.admin { border-color: #6f00ff; box-shadow: 0 0 20px #6f00ff; }

/* Hidden details */
.unit-details {
  display: none;
  margin-top: 10px;
  text-align: left;
  font-size: 14px;
}

.unit-card.active .unit-details {
  display: block;
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ========== SUMMON BUTTON ========== */
#summon-section {
  text-align: center;
  margin-top: 40px;
}

#summonBtn {
  background: linear-gradient(90deg, #00ffff, #007bff);
  border: none;
  color: white;
  padding: 10px 25px;
  font-size: 1.1rem;
  border-radius: 12px;
  cursor: pointer;
  box-shadow: 0 0 20px #00ffff;
  transition: all 0.2s;
}

#summonBtn:hover {
  transform: scale(1.1);
  box-shadow: 0 0 35px #00ccff;
}

#summonResult {
  margin-top: 20px;
  font-size: 1.3rem;
  text-shadow: 0 0 10px #00ffff;
}

/* Animation glow when summon */
@keyframes glow {
  from { text-shadow: 0 0 10px #00ffff; }
  to { text-shadow: 0 0 25px #00ccff; }
}
  </style>
</head>
<body class="bg-black text-gray-100 font-sans">

  <div class="max-w-5xl mx-auto px-6 py-10">
    <header class="text-center mb-10">
      <h1 class="text-4xl font-bold text-white">Machine Tower Defense</h1>
      <p class="text-gray-400 italic">Summon & Stats Demo</p>
    </header>

    <h2 class="text-2xl font-semibold text-blue-400 mb-4 border-b border-gray-700 pb-2">Units</h2>

    <!-- UNIT GRID -->
    <div class="unit-grid">

      <div class="unit-card normal">
        <h3>Normal Agent</h3>
        <div class="unit-details">
          <p><strong>Kameraman</strong>: DPS 5 → 20 | Range 5 → 10</p>
          <p><strong>Spikerman</strong>: DPS 7 → 25 | Range 5 → 10</p>
        </div>
      </div>

      <div class="unit-card special">
        <h3>Special Agent</h3>
        <div class="unit-details">
          <p><strong>Plunger Kameraman</strong>: DPS 20 → 80 | Range 15 → 40</p>
          <p><strong>Dark Knife Spikerman</strong>: DPS 25 → 100 | Range 10 → 25</p>
        </div>
      </div>

      <div class="unit-card large">
        <h3>Large Agent</h3>
        <div class="unit-details">
          <p><strong>Large Spikerman</strong>: DPS 100 → 500 | Range 15 → 40</p>
        </div>
      </div>

      <div class="unit-card titan">
        <h3>Titan</h3>
        <div class="unit-details">
          <p><strong>Titan Kameraman</strong>: DPS 25 → 250 | Range 40 → 75</p>
        </div>
      </div>

      <div class="unit-card upgraded">
        <h3>Upgraded Titan</h3>
        <div class="unit-details">
          <p><strong>Upgraded Titan Kameraman</strong>: DPS 240 → 5000 | Range 40 → 70</p>
        </div>
      </div>

      <div class="unit-card admin">
        <h3>Admin Unit</h3>
        <div class="unit-details">
          <p><strong>Cheems_sama Kameraman</strong>: DPS ∞ | Range ∞ | Deletes enemies instantly 😈</p>
        </div>
      </div>

    </div>

    <!-- SUMMON SECTION -->
    <div id="summon-section">
      <button id="summonBtn">🎲 Summon Unit</button>
      <p id="summonResult"></p>
    </div>
  </div>

  <script>
  // === CARD CLICK TOGGLE ===
  document.querySelectorAll('.unit-card').forEach(card => {
    card.addEventListener('click', () => {
      card.classList.toggle('active');
    });
  });

  // === SUMMON SYSTEM ===
  const units = [
    { name: "Normal Agent", rarity: "Normal", rate: 70.898999, color: "#00ffff" },
    { name: "Special Agent", rarity: "Special", rate: 28, color: "gold" },
    { name: "Large Agent", rarity: "Large", rate: 1, color: "lime" },
    { name: "Titan", rarity: "Titan", rate: 0.01, color: "red" },
    { name: "Upgraded Titan", rarity: "Godly", rate: 0.000001, color: "#007bff" }
  ];

  const summonBtn = document.getElementById("summonBtn");
  const summonResult = document.getElementById("summonResult");

  summonBtn.addEventListener("click", () => {
    let random = Math.random() * 100;
    let cumulative = 0;
    let result = units[0];

    for (const u of units) {
      cumulative += u.rate;
      if (random <= cumulative) { result = u; break; }
    }

    summonResult.innerHTML = `✨ You summoned a <span style="color:${result.color}; font-weight:bold;">${result.name}</span> (${result.rarity})!`;
    summonResult.style.animation = "glow 1.5s infinite alternate";
  });
  </script>

</body>
</html>
